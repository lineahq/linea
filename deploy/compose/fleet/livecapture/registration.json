{
  "plugins": [
    {
      "id": "livecapture",
      "version": "0.4.0",
      "api_version": "2",
      "endpoint": "http://livecapture-plugin:8090",
      "enabled": true,
      "allow_insecure_http": true,
      "permissions": [
        "agents.read",
        "credentials.introspect"
      ],
      "host_token_file": "/run/secrets/capture_host_token",
      "service_token_file": "/run/secrets/capture_service_token"
    }
  ]
}
