# Settings for compose.yaml, all optional. Copy to .env beside it and run
# docker compose up -d again to apply a change. Secrets are not here: they
# are the files in secrets/ (compose.yaml lists them).

# --- The built-in admin account ---------------------------------------------
# Sign in as "admin" with the password in secrets/admin_password. Set this
# empty to turn the account off once someone signed in through your identity
# provider holds the admin role.
# LINEA_AUTHENTICATION_ADMIN_PASSWORD_FILE=

# --- Address ---------------------------------------------------------------
# The server's plain-HTTP port, on 127.0.0.1 only. To reach it from other
# machines, put your HTTPS reverse proxy in front and bind an address it can
# reach (docs/debugger/deploy-compose.md).
# LINEA_BIND=127.0.0.1
# LINEA_PORT=7070

# --- Sign in with an identity provider (OIDC) -------------------------------
# Register https://<your address>/auth/callback with the provider, and put
# its client secret in secrets/oidc_client_secret.
# LINEA_AUTHENTICATION_OIDC_ISSUER=https://idp.example.com
# LINEA_AUTHENTICATION_OIDC_CLIENT_ID=linea
# LINEA_AUTHENTICATION_OIDC_REDIRECT_URL=https://linea.example.com/auth/callback
# A public client for linea login's device sign-in (optional):
# LINEA_AUTHENTICATION_OIDC_CLI_CLIENT_ID=linea-cli
# Who may do what. The admin account needs no binding.
# LINEA_BINDINGS=[{group: linea-admins, role: admin, scope: "*"}, {group: engineering, role: engineer, scope: "*"}]

# --- Bounds ----------------------------------------------------------------
# Every server setting has a variable: LINEA_ and its key path in capitals
# (docs/debugger/team-server.md). compose.yaml passes these through:
# LINEA_STORE_STORAGE_LIMIT=4GiB
# LINEA_RETENTION_AGE=720h
# LINEA_LIMITS_QUEUE=64

# --- Resources -------------------------------------------------------------
# Limits, not reservations. Docker refuses a CPU limit above the machine's
# CPU count; lower these on a small machine.
# LINEA_SERVER_CPUS=2
# LINEA_SERVER_MEMORY=1g
# LINEA_POOL_CAPACITY=4
# LINEA_POOL_CPUS=4
# LINEA_POOL_MEMORY=4g
# LINEA_BUILDER_CPUS=4
# LINEA_BUILDER_MEMORY=5g

# The image release; dev with docker compose up -d --build in a checkout.
# LINEA_VERSION=0.2.0

# --- Fleet and live capture (optional) ---------------------------------------
# Only for compose.fleet.yaml, started by scripts/debugger/compose-fleet.sh
# (docs/debugger/deploy-compose.md#fleet-and-live-capture). Its secrets are
# more files in secrets/, and its plugin settings are livecapture.json; the
# header of compose.fleet.yaml lists both. Ports, all on LINEA_FLEET_BIND:
# LINEA_FLEET_BIND=127.0.0.1
# LINEA_FLEET_PORT=8080
# LINEA_FLEET_AGENT_PORT=4320
# LINEA_CAPTURE_CONTROL_PORT=4340
# LINEA_CAPTURE_DELIVERY_PORT=4341
# LINEA_FLEET_SERVER_ID=linea-fleet
# LINEA_FLEET_CONFIG_MANAGEMENT=false
# Your own copy of livecapture.json, kept out of the files an upgrade replaces:
# LINEA_CAPTURE_CONFIG=./livecapture.local.json

# --- Secrets directory -----------------------------------------------------
# Where the secret files are, ./secrets beside compose.yaml by default.
# LINEA_SECRETS_DIR=./secrets
